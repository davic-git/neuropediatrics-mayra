# URL pública final, sem barra no fim. Necessária para canonical, og:url, JSON-LD e sitemap.
VITE_SITE_URL=

# DSN público do projeto Sentry. Deixe vazio para manter o monitoramento desabilitado.
VITE_SENTRY_DSN=

# Measurement ID público do Google Analytics 4 (formato G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=
